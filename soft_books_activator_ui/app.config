    <add name="SBSaccoDBEntities" connectionString="metadata=res://*/SBSaccoDBEntities.csdl|res://*/SBSaccoDBEntities.ssdl|res://*/SBSaccoDBEntities.msl;provider=System.Data.SqlClient;provider connection string=&quot;data source=.\sqlexpress;initial catalog=SBSaccoDB_january_2023;persist security info=True;user id=sa;password=123456789;multipleactiveresultsets=True;App=EntityFramework&quot;" providerName="System.Data.EntityClient"/>

